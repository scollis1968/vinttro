{
	"$schema": "https://schemas.wp.org/wp/6.9/theme.json",
	"version": 3,
	"settings": {
		"color": {
			"palette": [
				{
					"color": "#FFFFFF",
					"name": "Base",
					"slug": "base"
				},
				{
					"color": "#111111",
					"name": "Contrast",
					"slug": "contrast"
				},
				{
					"color": "#595959",
					"name": "Accent 1",
					"slug": "accent-1"
				},
				{
					"color": "#916d1c",
					"name": "Accent 2",
					"slug": "accent-2"
				},
				{
					"color": "#e4083b",
					"name": "Accent 3",
					"slug": "accent-3"
				},
				{
					"color": "#0f36e4",
					"name": "Accent 4",
					"slug": "accent-4"
				},
				{
					"color": "#64f434",
					"name": "Accent 5",
					"slug": "accent-5"
				},
				{
					"color": "#000000",
					"name": "Accent 6",
					"slug": "accent-6"
				}
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"fontFace": [
						{
							"fontFamily": "Montserrat",
							"fontStyle": "normal",
							"fontWeight": "300",
							"src": "http://uat.vinttro.co.uk/wp-content/uploads/fonts/JTUHjIg1_i6t8kCHKm4532VJOt5-QNFgpCs16Ew7Y3tcoqK5.woff2"
						}
					],
					"fontFamily": "Montserrat",
					"name": "Montserrat",
					"slug": "montserrat"
				}
			]
		}
	},
	"styles": {
		"blocks": {
			"core/button": {
				"color": {
					"background": "var(--wp--preset--color--accent-2)",
					"text": "var(--wp--preset--color--base)"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--base)"
						}
					}
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontStyle": "normal",
					"fontWeight": "600",
					"lineHeight": "0",
					"textTransform": "none"
				}
			},
			"core/heading": {
				"color": {
					"text": "var(--wp--preset--color--accent-2)"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--accent-2)"
						}
					}
				}
			},
			"core/list": {
				"css": "& li{margin-top: 0.5rem;}\n& ul{ list-style-type: square; }"
			}
		},
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--accent-1)"
		},
		"elements": {
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent-2)",
					"text": "var(--wp--preset--color--contrast)"
				}
			},
			"caption": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--montserrat)"
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--montserrat)",
					"fontStyle": "normal",
					"fontWeight": "300"
				}
			},
			"link": {
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--accent-2)"
					}
				},
				"color": {
					"text": "var(--wp--preset--color--accent-1)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--montserrat)"
				}
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--montserrat)",
			"fontStyle": "normal",
			"fontWeight": "300"
		}
	}
}